<%!
    #include <time.h>
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Klin start page</title>
  <link rel="stylesheet" href="kl.css">
</head>
<body>
  <main>
    <h1>Welcome to Klin <%= KLIN_VERSION %></h1>

    <p class="lead">This page is compiled into klind: the server, its
    configuration and this site are one program.</p>

    <section class="card">
      <h2>Device time</h2>
      <p class="value"><%
          time_t now = time(NULL);
          io_printf(out, "%s", ctime(&now));
      %></p>
      <p class="note">Written by C code in <code>www/index.kl1</code>,
      run for every request.</p>
    </section>

    <section class="card">
      <h2>Next steps</h2>
      <ul>
        <li>Edit <code>doc/example-site/www/index.kl1</code> and run
            <code>cmake --build out</code> again.</li>
        <li>Read <a href="https://github.com/DanielTillett/klin/blob/master/doc/PAGES.md">Writing a site</a>.</li>
        <li>See the <a href="https://github.com/DanielTillett/klin#readme">documentation</a>
            and the <a href="https://github.com/DanielTillett/klin">project home</a>.</li>
      </ul>
    </section>
  </main>

  <footer>
    Klin, derived from <a href="https://github.com/koanlogic/klone">KLone</a>
    by KoanLogic s.r.l. &middot; BSD-3-Clause
  </footer>
</body>
</html>
